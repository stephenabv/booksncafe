{
  "name": "booksncafe",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node --import tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:verify": "node --import tsx scripts/verify.ts",
    "admin:create": "node --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
