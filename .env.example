# ---------------------------------------------------------------------------
# Books 'n Cafe environment variables. Copy to .env.local for local development.
# Never commit real values. On Vercel, set these per environment (Production /
# Preview / Development). The Neon Marketplace integration sets DATABASE_URL and
# DATABASE_URL_UNPOOLED automatically, including per-preview-branch databases.
# ---------------------------------------------------------------------------

# Pooled connection string used by the running application (server-only).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/booksncafe

# Direct (non-pooled) connection used by migrations and scripts. Optional locally.
DATABASE_URL_UNPOOLED=

# Canonical public origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated list of extra hosts allowed for remote images
# (images.unsplash.com is always allowed). Rebuild after changing.
NEXT_PUBLIC_IMAGE_HOSTS=

# Admin session lifetime in hours (default 12).
SESSION_TTL_HOURS=12

# Set to "1" only on preview deployments to run migrations during `vercel-build`.
# Production migrations are run manually: see docs/DEPLOYMENT.md.
RUN_MIGRATIONS_ON_BUILD=
